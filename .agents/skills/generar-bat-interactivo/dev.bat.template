@echo off
chcp 65001 >nul
setlocal EnableExtensions EnableDelayedExpansion
title <NombreProyecto> - Punto de entrada para desarrollo

REM =====================================================================
REM dev.bat - Plantilla canonica del hub CerebroOperativoIA
REM ---------------------------------------------------------------------
REM Esta plantilla NO es copia-pega literal. Es un material auxiliar para
REM que la IA aplique la skill `generar-bat-interactivo` con un esqueleto
REM consistente, encabezado, helpers y prefijos ya fijados.
REM
REM Reglas duras (ver skill `generar-bat-interactivo` + estandar-dev-bat.md):
REM   - Nombre fijo: dev.bat en .scripts/dev.bat.
REM   - Cabecera canonica en lineas 1-4: @echo off / chcp 65001 / setlocal
REM     / title <Proyecto> - Punto de entrada para desarrollo.
REM   - Encoding UTF-8 sin BOM, CRLF.
REM   - Idioma del UI: espanol; prefijos [INFO]/[OK]/[WARN]/[ERROR].
REM   - Confirmaciones obligatorias antes de matar procesos, borrar caches
REM     o destruir artefactos. taskkill SIEMPRE por PID, nunca por imagen.
REM   - Prohibido hardcodear credenciales; leer solo de .env o variables
REM     de entorno.
REM   - Menu unico (dev/build/stop/diagnostico...). Iniciar/detener son
REM     opciones del mismo menu, no scripts separados.
REM
REM Como adaptar este esqueleto:
REM   1. Sustituir <NombreProyecto> por el nombre real del proyecto.
REM   2. Sustituir <Stack detectado> por el stack real (Next/Vite/.NET...).
REM   3. Activar o desactivar los bloques marcados con
REM      `REM [INCLUIR SI: ...]` segun el stack detectado.
REM   4. Verificar cada comando contra package.json, *.sln, pyproject.toml
REM      o equivalente real. No inventar tooling.
REM   5. Reemplazar <puerto_dev> por el puerto real (3000, 5173, 8000...).
REM   6. Ajustar <comando_dev> y <comando_build> a los scripts reales.
REM =====================================================================

REM ---------------------------------------------------------------------
REM Configuracion base del proyecto
REM ---------------------------------------------------------------------
set "PROJECT_NAME=<NombreProyecto>"
set "STACK_DETECTED=<Stack detectado>"
REM PROJECT_ROOT apunta a la raiz del proyecto (donde esta package.json).
REM Si este .bat vive en .scripts/, PROJECT_ROOT es la carpeta madre.
if exist "%~dp0package.json" (
    set "PROJECT_ROOT=%~dp0"
) else (
    for %%I in ("%~dp0\..") do set "PROJECT_ROOT=%%~fI\"
)
cd /d "%PROJECT_ROOT%"
set "PORT_DEV=<puerto_dev>"

REM ---------------------------------------------------------------------
REM Deteccion de stack
REM ---------------------------------------------------------------------
REM [INCLUIR SI: vitest detectado]
set "HAS_VITEST=0"
if exist "vitest.config.ts" set "HAS_VITEST=1"
if exist "vitest.config.js" set "HAS_VITEST=1"
if exist "vitest.config.mjs" set "HAS_VITEST=1"

REM [INCLUIR SI: playwright detectado]
set "HAS_PLAYWRIGHT=0"
if exist "playwright.config.ts" set "HAS_PLAYWRIGHT=1"
if exist "playwright.config.js" set "HAS_PLAYWRIGHT=1"

REM [INCLUIR SI: docker presente]
set "HAS_DOCKER=0"
where docker >nul 2>nul && set "HAS_DOCKER=1"

REM [INCLUIR SI: cloudflared presente]
set "HAS_CLOUDFLARED=0"
where cloudflared >nul 2>nul && set "HAS_CLOUDFLARED=1"

REM [INCLUIR SI: backend .NET + frontend Node]
set "HAS_DOTNET=0"
where dotnet >nul 2>nul && set "HAS_DOTNET=1"

REM ---------------------------------------------------------------------
REM Helpers canonicos (nombres exactos del estandar; sin variantes)
REM ---------------------------------------------------------------------
goto :main_menu

:print_section
REM Imprime una cabecera de seccion con prefijo [INFO].
REM Uso: call :print_section "Titulo de la seccion"
echo.
echo [INFO] %~1
echo ----------------------------------------
goto :eof

:ensure_project
REM Aborta con [ERROR] si no estamos dentro de un proyecto detectable.
if not exist "package.json" (
    if not exist "*.sln" (
        if not exist "pyproject.toml" (
            echo [ERROR] No se detecta package.json, *.sln ni pyproject.toml en %PROJECT_ROOT%.
            echo [ERROR] Ejecuta este script desde la raiz del proyecto.
            exit /b 1
        )
    )
)
goto :eof

:detect_package_manager
REM Detecta gestor de paquetes Node: pnpm > yarn > npm > bun.
set "PKG_MANAGER=npm"
where pnpm >nul 2>nul && set "PKG_MANAGER=pnpm" && goto :eof
where yarn >nul 2>nul && set "PKG_MANAGER=yarn" && goto :eof
where bun >nul 2>nul && set "PKG_MANAGER=bun" && goto :eof
goto :eof

:check_port
REM Comprueba si %PORT_DEV% esta libre. Devuelve PORT_PID si ocupado.
set "PORT_IN_USE=0"
set "PORT_PID="
for /f "tokens=5" %%P in ('netstat -ano ^| findstr ":%PORT_DEV% " ^| findstr "LISTENING"') do (
    set "PORT_IN_USE=1"
    set "PORT_PID=%%P"
)
goto :eof

:confirm
REM Pregunta S/N. Uso: call :confirm "Mensaje". Devuelve CONFIRM_ANSWER.
REM Usa choice /c SN /n /m. Devuelve 0 para Si, 1 para No.
set "CONFIRM_MSG=%~1"
set "CONFIRM_ANSWER=1"
choice /c SN /n /m "%CONFIRM_MSG% (S/N): "
if !errorlevel! equ 1 set "CONFIRM_ANSWER=0"
goto :eof

:kill_port
REM Atribuye proceso al puerto, pide confirmacion, mata SOLO ese PID.
REM NEVER mata por nombre de imagen. Uso: call :kill_port %PORT_DEV%
set "KP_PORT=%~1"
call :check_port
if "!PORT_IN_USE!"=="0" (
    echo [OK] Puerto %KP_PORT% libre.
    goto :eof
)
echo [WARN] El puerto %KP_PORT% esta ocupado por PID !PORT_PID!.
echo [INFO] Revisa que ese PID pertenezca a este proyecto antes de matarlo.
echo [INFO] Si no estas seguro, aborta y revisa el PID manualmente.
call :confirm "Terminar el PID !PORT_PID!?"
if "!CONFIRM_ANSWER!"=="1" (
    echo [INFO] Operacion cancelada. No se mato ningun proceso.
    goto :eof
)
taskkill /F /PID !PORT_PID!
if errorlevel 1 (
    echo [ERROR] No se pudo terminar el PID !PORT_PID!.
    set "PORT_IN_USE=1"
    goto :eof
)
echo [OK] PID !PORT_PID! terminado.
set "PORT_IN_USE=0"
set "PORT_PID="
goto :eof

:require_node
REM Aborta con [ERROR] si Node no esta en PATH. Usar en proyectos Node.
where node >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Node.js no esta en PATH.
    echo [ERROR] Instala Node o abre el proyecto desde un shell con Node disponible.
    exit /b 1
)
goto :eof

:diagnose
REM Diagnostico del entorno con [OK]/[WARN]/[ERROR].
call :print_section "Diagnostico del entorno"
echo [INFO] Version de Node:
where node >nul 2>nul && (node --version) || echo [WARN] Node no detectado.
echo [INFO] Version de %PKG_MANAGER%:
where %PKG_MANAGER% >nul 2>nul && (%PKG_MANAGER% --version) || echo [WARN] %PKG_MANAGER% no detectado.
REM [INCLUIR SI: docker presente]
if "%HAS_DOCKER%"=="1" (
    echo [INFO] Docker detectado. Version:
    docker --version
) else (
    echo [WARN] Docker no detectado en PATH.
)
REM [INCLUIR SI: vitest detectado]
if "%HAS_VITEST%"=="1" echo [INFO] Vitest detectado.
REM [INCLUIR SI: playwright detectado]
if "%HAS_PLAYWRIGHT%"=="1" echo [INFO] Playwright detectado.
REM [INCLUIR SI: backend .NET + frontend Node]
if "%HAS_DOTNET%"=="1" (
    echo [INFO] dotnet detectado. Version:
    dotnet --version
)
call :check_port
if "!PORT_IN_USE!"=="1" (
    echo [WARN] Puerto %PORT_DEV% ocupado por PID !PORT_PID!.
) else (
    echo [OK] Puerto %PORT_DEV% libre.
)
echo [INFO] Archivos criticos:
if exist "package.json" (echo [OK] package.json) else (echo [FALTA] package.json)
if exist "node_modules" (echo [OK] node_modules\) else (echo [FALTA] node_modules\)
if exist ".env.local" (echo [OK] .env.local) else (echo [WARN] .env.local ausente)
goto :eof

REM =====================================================================
REM Menu principal (orden canonico: dev / build / stop / diagnostico / ...)
REM =====================================================================
:main_menu
call :ensure_project
call :detect_package_manager
cls
echo.
echo  ========================================
echo   %PROJECT_NAME% - Punto de entrada para desarrollo
echo  ========================================
echo   Stack: %STACK_DETECTED% ^| Puerto dev: %PORT_DEV% ^| Gestor: %PKG_MANAGER%
echo  ========================================
echo.
echo   1 - Iniciar dev server (abre navegador)
echo   2 - Compilar / Build
echo   3 - Detener dev server del puerto %PORT_DEV%
echo   4 - Diagnostico del entorno
echo   5 - Reinstalar dependencias (%PKG_MANAGER% install)
echo   0 - Salir
echo  ========================================
echo.
set /p "MENU_OPT=Selecciona una opcion [0-5]: "

if "%MENU_OPT%"=="1" goto :opt_dev
if "%MENU_OPT%"=="2" goto :opt_build
if "%MENU_OPT%"=="3" goto :opt_stop
if "%MENU_OPT%"=="4" goto :opt_diagnose
if "%MENU_OPT%"=="5" goto :opt_install
if "%MENU_OPT%"=="0" goto :opt_exit

echo [WARN] Opcion no valida: "%MENU_OPT%". Intentalo de nuevo.
pause
goto :main_menu

REM ---------------------------------------------------------------------
REM Opcion 1 - Iniciar dev server (con apertura automatica de navegador)
REM ---------------------------------------------------------------------
:opt_dev
call :print_section "Iniciar dev server"
call :require_node
call :check_port
if "!PORT_IN_USE!"=="1" (
    echo [WARN] El puerto %PORT_DEV% ya esta ocupado por PID !PORT_PID!.
    call :confirm "Terminar el PID !PORT_PID! para liberar el puerto?"
    if "!CONFIRM_ANSWER!"=="1" (
        echo [INFO] Operacion cancelada por el usuario.
        pause
        goto :main_menu
    )
    taskkill /F /PID !PORT_PID!
    if errorlevel 1 (
        echo [ERROR] No se pudo terminar el PID !PORT_PID!. Abortando.
        pause
        goto :main_menu
    )
    echo [OK] PID !PORT_PID! terminado.
)
echo [INFO] Lanzando dev server...
REM Reemplazar <comando_dev> por el script real del proyecto.
start "" /B cmd /c "<comando_dev>"
echo [INFO] Esperando arranque del servidor...
timeout /t 3 /nobreak >nul
start "" "http://localhost:%PORT_DEV%"
echo [OK] Navegador abierto en http://localhost:%PORT_DEV%.
echo [WARN] El servidor corre en segundo plano. Usa la opcion 3 para detenerlo.
pause
goto :main_menu

REM ---------------------------------------------------------------------
REM Opcion 2 - Compilar / Build
REM ---------------------------------------------------------------------
:opt_build
call :print_section "Compilar / Build"
echo [INFO] Ejecutando build...
REM Reemplazar <comando_build> por el script real del proyecto.
call <comando_build>
if errorlevel 1 (
    echo [ERROR] El build fallo.
) else (
    echo [OK] Build completado.
)
pause
goto :main_menu

REM ---------------------------------------------------------------------
REM Opcion 3 - Detener dev server del puerto
REM ---------------------------------------------------------------------
:opt_stop
call :print_section "Detener dev server del puerto %PORT_DEV%"
call :kill_port %PORT_DEV%
pause
goto :main_menu

REM ---------------------------------------------------------------------
REM Opcion 4 - Diagnostico del entorno (helper :diagnose)
REM ---------------------------------------------------------------------
:opt_diagnose
call :diagnose
echo.
pause
goto :main_menu

REM ---------------------------------------------------------------------
REM Opcion 5 - Reinstalar dependencias (doble confirmacion)
REM ---------------------------------------------------------------------
:opt_install
call :print_section "Reinstalar dependencias"
echo [WARN] Esto eliminara node_modules y reinstalara desde cero.
call :confirm "Borrar node_modules y reinstalar?"
if "!CONFIRM_ANSWER!"=="1" (
    echo [INFO] Operacion cancelada.
    pause
    goto :main_menu
)
call :confirm "Confirmar de nuevo: estas seguro?"
if "!CONFIRM_ANSWER!"=="1" (
    echo [INFO] Operacion cancelada.
    pause
    goto :main_menu
)
if exist "node_modules" (
    echo [WARN] Eliminando node_modules existente...
    rmdir /S /Q "node_modules"
)
call %PKG_MANAGER% install
if errorlevel 1 (
    echo [ERROR] Fallo la instalacion.
) else (
    echo [OK] Dependencias reinstaladas.
)
pause
goto :main_menu

REM ---------------------------------------------------------------------
REM Opcion 0 - Salir
REM ---------------------------------------------------------------------
:opt_exit
call :check_port
if "!PORT_IN_USE!"=="1" (
    echo [WARN] El PID !PORT_PID! sigue ocupando el puerto %PORT_DEV%.
    echo [WARN] Revisa si quieres detenerlo antes de salir.
)
echo [INFO] Saliendo de %PROJECT_NAME%.
endlocal
exit /b 0
